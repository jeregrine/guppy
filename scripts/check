#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "$repo_root"
mix test
mix run --no-start examples/stress_test.exs -- --validate-only
mix format --check-formatted
mix credo --strict
mix ex_dna lib examples --max-clones 0
mix reach.check --arch --smells
mix reach.check --smells 'examples/**/*.exs'

cd "$repo_root/native/guppy_nif"
cargo test
cargo clippy --all-targets -- -D warnings
cargo fmt --check
