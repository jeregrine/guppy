#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

# Validate the consumer default: precompiled artifact download.
unset GUPPY_NATIVE_FORCE_BUILD

# A version bump lands before its tag's artifact finishes building, so skip
# (loudly) when the artifact is not published yet; the release runbook
# validates the download path after the tag build completes.
version="$(sed -n 's/.*version: "\([0-9.]*\)",/\1/p' "$repo_root/mix.exs" | head -1)"
artifact_url="https://github.com/jeregrine/guppy/releases/download/v${version}/libguppy_nif-v${version}-nif-2.15-aarch64-apple-darwin.so.tar.gz"
if ! curl -fsIL "$artifact_url" >/dev/null 2>&1; then
  echo "skipping consumer download smoke: no published artifact for v${version} yet (${artifact_url})"
  exit 0
fi

cd "$tmpdir"
mix new guppy_load_smoke >/dev/null
cd guppy_load_smoke

python3 - <<PY
from pathlib import Path
path = Path('mix.exs')
text = path.read_text()
text = text.replace('      # {:dep_from_hexpm, "~> 0.3.0"},\n      # {:dep_from_git, git: "https://github.com/elixir-lang/my_dep.git", tag: "0.1.0"}\n', '      {:guppy, path: "${repo_root}"}\n')
path.write_text(text)
PY

mix deps.get >/dev/null
mix run -e 'Application.ensure_all_started(:guppy); {:ok, :pong} = Guppy.ping(); {:ok, "guppy_nif_rust_core"} = Guppy.native_build_info(); IO.puts("guppy clean install/load smoke ok")'
